{
  "schema_version": 1,
  "targets": {
    "reference": {
      "kind": "original_online",
      "layer": "browser_ui",
      "command": [
        "node",
        "projects/duolingo-web/original-adapter-v2.mjs"
      ],
      "acceptance_paths": [
        "projects/duolingo-web/original-adapter-v2.mjs",
        "projects/duolingo-web/package.json",
        "projects/duolingo-web/package-lock.json"
      ]
    },
    "candidate": {
      "kind": "candidate",
      "layer": "native_ui",
      "command": [
        "python3",
        "projects/duolingo-web/build-native.py"
      ],
      "acceptance_paths": [
        "projects/duolingo-web/build-native.py",
        "projects/duolingo-web/native-adapter-v3.swift"
      ]
    }
  }
}
